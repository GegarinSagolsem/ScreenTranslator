<Window x:Class="ScreenTranslator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenTranslator"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Left="0"
        Top="0"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        MouseUp="Window_MouseUp"
        KeyDown="Window_KeyDown">
    <Grid x:Name="RootGrid" Background="#44000000">
        <Rectangle x:Name="SelectionBox"
               Stroke="Red"
               StrokeThickness="2"
               Fill="Transparent"
               Visibility="Collapsed"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"/>
        <Canvas x:Name="TranslationCanvas"/>

        <!-- Sized to the primary monitor in code, so hints don't straddle two screens -->
        <Grid x:Name="PrimaryArea" HorizontalAlignment="Left" VerticalAlignment="Top">
            <!-- Shown while choosing a region -->
            <Border x:Name="HintPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,48,0,0"
                    Padding="16,9"
                    CornerRadius="6"
                    Background="#E6202020">
                <TextBlock x:Name="HintText"
                           Foreground="White"
                           FontSize="15"
                           Text="Drag to select the area to translate"/>
            </Border>

            <!-- Brief feedback for hotkeys (language, pause, opacity) -->
            <Border x:Name="StatusPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,48,0,0"
                    Padding="14,7"
                    CornerRadius="6"
                    Background="#E6202020"
                    Visibility="Collapsed">
                <TextBlock x:Name="StatusText" Foreground="White" FontSize="14"/>
            </Border>
        </Grid>
    </Grid>
</Window>
