<Window x:Class="ScreenTranslator.GameBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenTranslator game bar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Left="0"
        Top="0"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        Foreground="White"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WPF's built-in Fluent theme styles the standard controls; scoped to this window only -->
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.Dark.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
            <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF"/>
            <SolidColorBrush x:Key="SubtleTextBrush" Color="#B3FFFFFF"/>
            <SolidColorBrush x:Key="DividerBrush" Color="#26FFFFFF"/>

            <Style x:Key="PanelBorder" TargetType="Border">
                <Setter Property="Background" Value="#F2202020"/>
                <Setter Property="BorderBrush" Value="#33FFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.45"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="WidgetHeader" TargetType="Border">
                <Setter Property="Background" Value="#FF2C2C2C"/>
                <Setter Property="CornerRadius" Value="8,8,0,0"/>
                <Setter Property="Padding" Value="12,0,4,0"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="Cursor" Value="SizeAll"/>
            </Style>

            <Style x:Key="IconText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,14,0,6"/>
                <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}"/>
            </Style>

            <Style x:Key="IconButton" TargetType="ButtonBase">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ButtonBase">
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="IconToggle" TargetType="ToggleButton" BasedOn="{StaticResource IconButton}">
                <Style.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Home bar buttons: icon (from Tag) over a small label, highlighted when the widget is open -->
            <Style x:Key="HomeBarToggle" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Margin" Value="2,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid>
                                <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="14,6,14,7">
                                    <StackPanel>
                                        <TextBlock x:Name="Icon" Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}"
                                                   FontSize="18" HorizontalAlignment="Center"/>
                                        <ContentPresenter Margin="0,3,0,0" HorizontalAlignment="Center"
                                                          TextElement.FontSize="11"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="Indicator" Height="3" Width="18" CornerRadius="1.5" VerticalAlignment="Bottom"
                                        Background="{StaticResource AccentBrush}" Visibility="Collapsed"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF"/>
                                    <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!-- Dimmed screen behind the widgets; clicking it closes the bar -->
        <Border x:Name="Backdrop" Background="#59000000" MouseLeftButtonDown="Backdrop_MouseDown"/>

        <Canvas x:Name="WidgetLayer">

            <!-- ============ Translator widget ============ -->
            <Border x:Name="TranslatorWidget" Style="{StaticResource PanelBorder}" Width="340">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource WidgetHeader}"
                            MouseLeftButtonDown="Header_MouseDown" MouseMove="Header_MouseMove" MouseLeftButtonUp="Header_MouseUp">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;"
                                    ToolTip="Hide widget" Click="CloseWidget_Click"/>
                            <ToggleButton x:Name="TranslatorPinToggle" DockPanel.Dock="Right" Style="{StaticResource IconToggle}"
                                          Content="&#xE718;" ToolTip="Pin: keep this widget on screen when the bar is closed"/>
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE774;" Margin="0,0,10,0"/>
                            <TextBlock Text="Translator" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <StackPanel Margin="16,14,16,16">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="Gray" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Margin="10,0,0,0" FontSize="15" FontWeight="SemiBold"
                                       Text="No region selected"/>
                        </StackPanel>

                        <UniformGrid Columns="2" Margin="0,14,0,0">
                            <Button Margin="0,0,4,0" HorizontalAlignment="Stretch" Click="SelectRegion_Click"
                                    ToolTip="Ctrl+Shift+R">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE7A8;"/>
                                    <TextBlock Text="Select region" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="PauseButton" Margin="4,0,0,0" HorizontalAlignment="Stretch" Click="Pause_Click"
                                    ToolTip="Ctrl+Shift+P">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="PauseIcon" Style="{StaticResource IconText}" Text="&#xE769;"/>
                                    <TextBlock x:Name="PauseLabel" Text="Pause" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Translate from"/>
                        <ComboBox x:Name="SourceLanguageBox" DisplayMemberPath="Name" HorizontalAlignment="Stretch"
                                  SelectionChanged="SourceLanguage_Changed"/>

                        <CheckBox x:Name="VerticalTextCheck" Margin="0,8,0,0" Content="Vertical text (columns, read right to left)"
                                  ToolTip="For vertical Chinese, as in novels and manga. Japanese vertical text is detected automatically."
                                  Checked="VerticalTextCheck_Changed" Unchecked="VerticalTextCheck_Changed"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Translate to"/>
                        <ComboBox x:Name="TargetLanguageBox" DisplayMemberPath="Name" HorizontalAlignment="Stretch"
                                  SelectionChanged="TargetLanguage_Changed"/>

                        <DockPanel Margin="0,14,0,0">
                            <TextBlock x:Name="OpacityValue" DockPanel.Dock="Right" Foreground="{StaticResource SubtleTextBrush}"/>
                            <TextBlock Text="Background opacity" Foreground="{StaticResource SubtleTextBrush}"
                                       ToolTip="Fades only the dark box behind each translation. The text stays solid, with an outline that keeps it readable even at 0 %."/>
                        </DockPanel>
                        <Slider x:Name="OpacitySlider" Margin="0,4,0,0" Minimum="0" Maximum="1"
                                SmallChange="0.05" LargeChange="0.25" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                ValueChanged="Opacity_Changed"/>
                        <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource SubtleTextBrush}"
                                   Text="Text always stays fully visible."/>

                        <DockPanel Margin="0,12,0,0">
                            <TextBlock x:Name="TextSizeValue" DockPanel.Dock="Right" Foreground="{StaticResource SubtleTextBrush}"/>
                            <TextBlock Text="Text size" Foreground="{StaticResource SubtleTextBrush}"
                                       ToolTip="100 % matches the size of the original text. Translations still shrink a little where space is tight."/>
                        </DockPanel>
                        <Slider x:Name="TextSizeSlider" Margin="0,4,0,0" Minimum="0.5" Maximum="2"
                                SmallChange="0.1" LargeChange="0.25" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                ValueChanged="TextSize_Changed"/>

                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,14"/>

                        <DockPanel>
                            <TextBlock x:Name="UsagePercent" DockPanel.Dock="Right" FontWeight="SemiBold"/>
                            <TextBlock x:Name="UsageTitle" Text="DeepL usage this month" Foreground="{StaticResource SubtleTextBrush}"/>
                        </DockPanel>
                        <ProgressBar x:Name="UsageBar" Margin="0,8,0,0" Minimum="0" Maximum="1"/>
                        <TextBlock x:Name="UsageText" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource SubtleTextBrush}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ============ Glossary widget ============ -->
            <Border x:Name="GlossaryWidget" Style="{StaticResource PanelBorder}" Width="420">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource WidgetHeader}"
                            MouseLeftButtonDown="Header_MouseDown" MouseMove="Header_MouseMove" MouseLeftButtonUp="Header_MouseUp">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;"
                                    ToolTip="Hide widget" Click="CloseWidget_Click"/>
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE82D;" Margin="0,0,10,0"/>
                            <TextBlock Text="Glossary" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <StackPanel Margin="16,14,16,16">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"
                                   Text="Terms listed here always translate exactly as written. Use it for character names, places and game jargon."/>
                        <TextBlock x:Name="GlossaryServiceNote" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" Foreground="#FCE100"
                                   Text="The glossary needs DeepL. Choose DeepL as the translation service in Settings to apply these terms."/>

                        <Grid Margin="0,14,40,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Original text" Foreground="{StaticResource SubtleTextBrush}"/>
                            <TextBlock Grid.Column="2" Text="Always translate as" Foreground="{StaticResource SubtleTextBrush}"/>
                        </Grid>

                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="GlossaryList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBox Grid.Column="2" Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}"/>
                                            <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE74D;"
                                                    HorizontalAlignment="Right" ToolTip="Remove term" Click="RemoveTerm_Click"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock x:Name="GlossaryEmpty" Margin="0,4,0,8" FontStyle="Italic"
                                   Foreground="{StaticResource SubtleTextBrush}" Text="No terms yet."/>

                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" MinWidth="84" Content="Save" Click="SaveGlossary_Click"/>
                            <TextBlock x:Name="GlossaryStatus" DockPanel.Dock="Right" Margin="0,0,12,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource SubtleTextBrush}"/>
                            <Button HorizontalAlignment="Left" Click="AddTerm_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE710;"/>
                                    <TextBlock Text="Add term" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ============ Settings widget ============ -->
            <Border x:Name="SettingsWidget" Style="{StaticResource PanelBorder}" Width="360">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource WidgetHeader}"
                            MouseLeftButtonDown="Header_MouseDown" MouseMove="Header_MouseMove" MouseLeftButtonUp="Header_MouseUp">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;"
                                    ToolTip="Hide widget" Click="CloseWidget_Click"/>
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE713;" Margin="0,0,10,0"/>
                            <TextBlock Text="Settings" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- Scrolls when the screen is too short for every setting -->
                    <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,0,16,16">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Translation service"/>
                        <ComboBox x:Name="ServiceBox" DisplayMemberPath="Name" HorizontalAlignment="Stretch"
                                  SelectionChanged="Service_Changed"/>
                        <TextBlock x:Name="ServiceDescription" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource SubtleTextBrush}"/>

                        <StackPanel x:Name="KeyPanel">
                            <DockPanel Margin="0,14,0,6">
                                <TextBlock DockPanel.Dock="Right" FontSize="12">
                                    <Hyperlink x:Name="KeyLink" Foreground="{StaticResource AccentBrush}" RequestNavigate="KeyLink_RequestNavigate">
                                        Get a key
                                    </Hyperlink>
                                </TextBlock>
                                <TextBlock x:Name="KeyLabel" Text="Your API key" Foreground="{StaticResource SubtleTextBrush}"/>
                            </DockPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Margin="8,0,0,0" MinWidth="70" Content="Save" Click="SaveKey_Click"/>
                                <PasswordBox x:Name="ApiKeyBox"/>
                            </DockPanel>
                            <TextBlock x:Name="KeyStatus" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource SubtleTextBrush}" Text="Stored only on this PC."/>
                        </StackPanel>

                        <DockPanel Margin="0,16,0,0">
                            <TextBlock x:Name="IntervalValue" DockPanel.Dock="Right" Foreground="{StaticResource SubtleTextBrush}"/>
                            <TextBlock Text="Check for new text every" Foreground="{StaticResource SubtleTextBrush}"/>
                        </DockPanel>
                        <Slider x:Name="IntervalSlider" Margin="0,4,0,0" Minimum="200" Maximum="2000"
                                SmallChange="100" LargeChange="500" TickFrequency="100" IsSnapToTickEnabled="True"
                                ValueChanged="Interval_Changed"/>

                        <CheckBox x:Name="MergeLinesCheck" Margin="0,12,0,0" Content="Join wrapped lines into sentences"
                                  ToolTip="Translate a paragraph that wraps over several lines as one sentence. Turn off if menu items get joined together."
                                  Checked="MergeLinesCheck_Changed" Unchecked="MergeLinesCheck_Changed"/>

                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,14"/>

                        <DockPanel Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Padding="8,2" FontSize="12" Content="Reset to defaults"
                                    Click="ResetHotkeys_Click"/>
                            <TextBlock Text="Hotkeys" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}"
                                   Text="Click a box and press new keys. Backspace turns a hotkey off; Esc cancels."/>
                        <!-- One row per command, built in code from HotkeyCommands -->
                        <StackPanel x:Name="HotkeyRows" Margin="0,8,0,0"/>
                        <TextBlock x:Name="HotkeyStatus" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="#FCE100"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Canvas>

        <!-- ============ Home bar ============ -->
        <Border x:Name="HomeBar" Style="{StaticResource PanelBorder}" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,20,0,0" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Image Source="/icon.ico" Width="22" Height="22" Margin="8,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="ScreenTranslator" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Border Width="1" Background="{StaticResource DividerBrush}" Margin="0,6,6,6"/>
                <ToggleButton x:Name="TranslatorToggle" Style="{StaticResource HomeBarToggle}" Tag="&#xE774;" Content="Translator"
                              Checked="WidgetToggle_Changed" Unchecked="WidgetToggle_Changed"/>
                <ToggleButton x:Name="GlossaryToggle" Style="{StaticResource HomeBarToggle}" Tag="&#xE82D;" Content="Glossary"
                              Checked="WidgetToggle_Changed" Unchecked="WidgetToggle_Changed"/>
                <ToggleButton x:Name="SettingsToggle" Style="{StaticResource HomeBarToggle}" Tag="&#xE713;" Content="Settings"
                              Checked="WidgetToggle_Changed" Unchecked="WidgetToggle_Changed"/>
                <Border Width="1" Background="{StaticResource DividerBrush}" Margin="6,6,0,6"/>
                <TextBlock x:Name="ClockText" FontSize="14" VerticalAlignment="Center" Margin="16,0,10,0"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Close (Esc)" Click="CloseBar_Click"
                        VerticalAlignment="Center" Margin="0,0,2,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
