<Window x:Class="ScreenTranslator.SnipResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenTranslator snip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="440"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        Foreground="White"
        KeyDown="Window_KeyDown"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.Dark.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="SubtleTextBrush" Color="#B3FFFFFF"/>
        </ResourceDictionary>
    </Window.Resources>

    <!-- The margin leaves room for the shadow -->
    <Border Margin="12" Padding="16,10,10,14" CornerRadius="8" Background="#F2202020" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Direction="270" Opacity="0.45"/>
        </Border.Effect>
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                        Padding="8,4" Background="Transparent" BorderThickness="0" ToolTip="Close (Esc)" Click="Close_Click"/>
                <TextBlock Text="&#xE8C1;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"
                           Foreground="#60CDFF" Margin="0,0,8,0"/>
                <TextBlock Text="Translation" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>

            <TextBlock x:Name="TranslationText" Margin="0,8,6,0" FontSize="15" TextWrapping="Wrap" Text="Reading the text…"/>
            <TextBlock x:Name="OriginalText" Margin="0,10,6,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource SubtleTextBrush}" Visibility="Collapsed"/>

            <DockPanel Margin="0,14,6,0">
                <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="Copy translation" IsEnabled="False" Click="Copy_Click"/>
                <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource SubtleTextBrush}"
                           Text="Esc or click elsewhere to close"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
