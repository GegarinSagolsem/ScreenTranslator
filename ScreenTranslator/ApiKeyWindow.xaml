<Window x:Class="ScreenTranslator.ApiKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenTranslator — DeepL API key"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
    <StackPanel Margin="18">
        <TextBlock TextWrapping="Wrap">
            ScreenTranslator uses DeepL to translate the text it reads. Paste your DeepL API key below — the free plan works.
        </TextBlock>
        <TextBlock Margin="0,6,0,0">
            <Hyperlink NavigateUri="https://www.deepl.com/your-account/keys" RequestNavigate="Hyperlink_RequestNavigate">
                Get a key from your DeepL account
            </Hyperlink>
        </TextBlock>
        <PasswordBox x:Name="KeyBox" Margin="0,14,0,0" Padding="4"/>
        <TextBlock x:Name="ErrorText" Margin="0,6,0,0" Foreground="Firebrick" Visibility="Collapsed"/>
        <TextBlock Margin="0,10,0,0" Foreground="Gray" FontSize="11" TextWrapping="Wrap">
            Saved only on this PC, in %AppData%\ScreenTranslator\config.json.
        </TextBlock>
        <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Width="84" IsDefault="True" Click="Save_Click"/>
            <Button Content="Cancel" Width="84" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
